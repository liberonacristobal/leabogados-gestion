{
  "name": "le-abogados-gestion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "VITE_CJS_IGNORE_WARNING=true node scripts/smoke-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "verificar": "vite build && npm run lint && npm run tipos && npm test && npm run smoke",
    "lint": "eslint --quiet src",
    "tipos": "tsc -p tsconfig.tipos.json && tsc -p tsconfig.reglas.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.3.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
